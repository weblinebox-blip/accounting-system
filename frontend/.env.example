# در Vercel (Production) این متغیر را در Project Settings > Environment Variables تنظیم کنید:
VITE_API_BASE_URL=https://accounting-system-api-gnzz.onrender.com

# در توسعه محلی (Local Dev) می‌توانید این را خالی بگذارید تا از پراکسی vite.config.js
# (که به http://localhost:4000 وصل است) استفاده شود. یا مقدار زیر را قرار دهید:
# VITE_API_BASE_URL=http://localhost:4000
